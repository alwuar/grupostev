APP_NAME="Grupo STEV"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo para "Olvidé mi contraseña" y los avisos de prospectos (SMTP del cPanel del cliente).
# La contraseña va solo en el .env del servidor, nunca en el repositorio.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.stevseguridadprivada.com
MAIL_PORT=465
MAIL_USERNAME=no-responder@stevseguridadprivada.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-responder@stevseguridadprivada.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Número que recibe los prospectos por WhatsApp (lada + número, sin + ni espacios)
WHATSAPP_NUMERO=522227611338

# Correo(s) que reciben un aviso por cada prospecto. Varios: separados por coma y SIN espacios.
# Si se deja vacío no se envía nada.
PROSPECTOS_CORREO=contacto@stevseguridadprivada.com

# WhatsApp de Agencia Vandu (botón del pie del panel). Si se deja vacío, el botón no aparece
VANDU_WHATSAPP=

# Datos del responsable en el Aviso de privacidad (/aviso-de-privacidad).
# Pon la razón social real del cliente y cambia la fecha cada vez que se modifique el aviso.
AVISO_RESPONSABLE="Grupo STEV Seguridad Privada"
AVISO_DOMICILIO="Av. Juárez Núm. 2509, Depto. 7, Col. La Paz, C.P. 72160, Puebla, Puebla, México"
AVISO_CORREO=contacto@stevseguridadprivada.com
AVISO_TELEFONO="222 761 1338"
AVISO_ACTUALIZADO=2026-10-14
